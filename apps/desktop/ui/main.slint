import { I18n } from "i18n.slint";
import { AssetCatalog } from "theme/assets.slint";
import { Palette } from "theme/palette.slint";
import { NewsPanel } from "components/news-panel.slint";
import { Hero } from "components/hero.slint";
import { Navigation } from "components/navigation.slint";
import { TitleBar } from "components/title-bar.slint";
import { MainPanel } from "components/main-panel.slint";
import { ProgressPanel } from "components/progress-panel.slint";
import { SettingsPanel } from "components/settings-panel.slint";
import { DiagnosticsPanel } from "components/diagnostics-panel.slint";
import { UpdatePanel } from "components/update-panel.slint";
import { AuthPanel } from "components/auth-panel.slint";
import { JavaPanel } from "components/java-panel.slint";

export component AppWindow inherits Window {
    icon: AssetCatalog.brand-mark;
    in property <bool> java-can-cancel: true;
    in property <float> java-progress;
    in property <bool> java-visible;
    in property <bool> java-busy;
    in property <bool> java-error;
    in property <string> java-message;
    callback java-install-requested();
    callback java-dismiss-requested();
    in-out property <string> nickname-input;
    in property <string> nickname-error;
    in property <string> version;
    in property <string> server-address;
    in property <bool> server-online;
    in property <int> ping-ms: -1;
    in property <string> server-status: I18n.tr("Проверка сервера");
    in property <int> server-signal;
    in property <string> launcher-status;
    in property <string> launcher-detail;
    in property <string> progress-metrics;
    in property <float> progress;
    in property <int> progress-percent;
    in property <bool> has-progress;
    in property <bool> loading;
    in property <bool> play-enabled;
    in property <string> play-label: I18n.tr("Играть");
    in property <bool> preparing;
    in property <bool> repairing;
    in property <bool> repair-available;
    in property <bool> cancel-allowed;
    in property <bool> cancel-pending;
    in property <bool> retry-available;
    in property <bool> retry-repair;
    in-out property <bool> auth-play-pending;
    in-out property <bool> settings-visible;
    in-out property <bool> news-visible;
    in-out property <string> memory-input;
    in property <int> memory-value;
    in property <int> memory-maximum;
    in property <string> memory-gib;
    in property <string> memory-error;
    in property <string> memory-suggestion;
    in property <bool> memory-detected;
    in property <bool> memory-save-enabled;
    in property <bool> memory-ready;
    in property <string> memory-problem;
    in property <string> installation-path;
    in-out property <bool> diagnostics-visible;
    in property <bool> diagnostics-available;
    in property <bool> diagnostics-refreshing;
    in property <string> diagnostics-reason;
    in property <string> diagnostics-advice;
    in property <bool> diagnostics-memory-action;
    in property <bool> diagnostics-repair-action;
    in-out property <bool> diagnostics-details-visible;
    in property <string> diagnostics-summary;
    in property <string> diagnostics-text;
    in property <string> launcher-log-path;
    in property <bool> auth-verified;
    in-out property <bool> auth-visible;
    in property <bool> auth-busy;
    in property <string> auth-message;
    in property <string> auth-link;
    in property <string> auth-code;
    in property <bool> auth-error;
    in-out property <int> auth-provider;
    callback auth-requested();
    callback auth-cancelled();
    callback auth-back-requested();
    callback auth-open-requested();
    callback auth-logout-requested();

    in property <bool> update-visible;
    in property <bool> update-busy;
    in property <bool> update-error;
    in property <bool> update-can-cancel: true;
    in property <string> update-current-version;
    in property <string> update-version;
    in property <string> update-message;
    in property <float> update-progress;
    callback update-install-requested();
    callback update-dismiss-requested();

    callback play-requested(string);
    callback settings-requested();
    callback repair-requested();
    callback cancel-requested();
    callback retry-requested();
    callback move-window(float, float);
    callback memory-input-edited(string);
    callback memory-slider-changed(float);
    callback memory-stepped(int);
    callback memory-save-requested();
    callback memory-back-requested();
    callback memory-retry-requested();
    callback memory-suggestion-requested();
    callback diagnostics-requested();
    callback diagnostics-close-requested();
    callback diagnostics-refresh-requested();
    callback logs-folder-requested();

    title: "Nevermore Launcher";
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: 1180px;
    preferred-height: 787px;
    min-width: 1180px;
    min-height: 787px;
    max-width: 1180px;
    max-height: 787px;
    private property <float> u: root.width / 1536px;
    private property <length> sidebar-width: clamp(root.width * 0.155, 184px, 238px);
    background: Palette.ink;
    default-font-family: "Arial";
    default-font-size: 15px;

    Image {
        source: AssetCatalog.background;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(90deg, #15101Ed9 0%, #15101E99 30%, #15101E24 57%, #15101E00 78%);
    }

    VerticalLayout {
        spacing: 0px;

        TitleBar {
            height: 74px * root.u;
            nickname <=> root.nickname-input;
            nickname-error: root.nickname-error;
            nickname-enabled: !root.loading && !root.update-visible && !root.java-visible;
            nickname-editable: false;
            auth-verified: root.auth-verified;
            account-active: root.auth-visible;
            account-clicked => { root.auth-visible = true; }
            settings-enabled: !root.loading && !root.auth-visible && !root.update-visible && !root.java-visible;
            settings-clicked => { root.settings-requested(); }

            minimize-clicked => {
                root.minimized = true;
            }

            close-clicked => {
                root.close();
            }

            move-requested(delta-x, delta-y) => {
                root.move-window(delta-x, delta-y);
            }
        }

        workspace := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Navigation {
                x: 0px; y: 0px; width: root.sidebar-width; height: parent.height;
                version: root.version;
                available: !root.loading && !root.settings-visible && !root.diagnostics-visible && !root.auth-visible && !root.update-visible && !root.java-visible;
                news-selected: root.news-visible;
                home-clicked => { root.news-visible = false; }
                news-clicked => { root.news-visible = true; }
            }

            if !root.settings-visible && !root.diagnostics-visible && !root.auth-visible: main-view := Rectangle {
            x: root.sidebar-width; width: parent.width - self.x; height: parent.height;
            background: transparent;
            if root.news-visible: NewsPanel {
                x: 32px; y: 28px;
                width: parent.width - 64px;
                height: parent.height - self.y - 32px;
            }
            if !root.news-visible: Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                hero := Hero {
                    x: 40px; y: max(24px, min(parent.height * 0.29 - 64px, launch-surface.y - self.height - 28px));
                    width: parent.width - 80px; height: 180px * self.u;
                    u: clamp(root.width / 1180px, 0.85, 1.18);
                }
                launch-surface := Rectangle {
                    x: 32px; y: parent.height - self.height - 32px;
                    width: parent.width - 64px;
                    height: root.preparing ? 238px : root.loading || root.diagnostics-available || root.memory-problem != "" ? 192px : 154px;
                    background: #1C1426ef; border-width: 1px; border-color: #B89AEF66; border-radius: 14px;
                    MainPanel {
                        x: 0px; y: 0px; width: parent.width; height: 106px; u: 1;
                        version: root.version; server-address: root.server-address;
                        server-online: root.server-online; ping-ms: root.ping-ms;
                        server-status: root.server-status; server-signal: root.server-signal;
                        loading: root.loading;
                        play-enabled: root.play-enabled && root.memory-ready && !root.update-visible && !root.java-visible;
                        play-label: root.play-label;
                        play-clicked => { root.play-requested(root.nickname-input); }
                    }
                    Rectangle { x: 24px; y: 105px; width: parent.width - 48px; height: 1px; background: #B89AEF24; }
                    ProgressPanel {
                        x: 24px; y: 114px; width: parent.width - 48px;
                        height: parent.height - self.y; u: 1;
                        status-text: !root.loading && root.play-enabled && root.memory-ready && !root.diagnostics-available ? I18n.tr("Всё готово к игре") : root.launcher-status; loading: root.preparing;
                        detail-text: root.memory-problem != "" ? root.memory-problem : root.loading || root.diagnostics-available ? root.launcher-detail : "";
                        metrics-text: root.progress-metrics;
                        progress: root.progress; progress-percent: root.progress-percent; has-progress: root.has-progress;
                        show-diagnostics: root.diagnostics-available && !root.update-visible;
                        show-cancel: root.preparing;
                        cancel-enabled: root.cancel-allowed && !root.cancel-pending && (!root.java-visible || root.java-can-cancel);
                        cancel-pending: root.cancel-pending;
                        show-retry: root.retry-available;
                        cancel-clicked => { root.cancel-requested(); }
                        retry-clicked => { root.retry-requested(); }
                        diagnostics-clicked => { root.diagnostics-requested(); }
                    }
                }

            }
            }
            if root.settings-visible && !root.diagnostics-visible && !root.auth-visible: SettingsPanel {
                x: (parent.width - self.width) / 2;
                y: 24px;
                width: 840px;
                height: parent.height - 48px;
                memory-input <=> root.memory-input;
                memory-value: root.memory-value;
                memory-maximum: root.memory-maximum;
                memory-gib: root.memory-gib;
                memory-error: root.memory-error;
                memory-suggestion: root.memory-suggestion;
                memory-detected: root.memory-detected;
                memory-save-enabled: root.memory-save-enabled;
                installation-path: root.installation-path;
                repair-enabled: root.repair-available && !root.loading && !root.update-visible && !root.java-visible;
                repair-requested => { root.repair-requested(); }
                input-edited(value) => { root.memory-input-edited(value); }
                slider-changed(value) => { root.memory-slider-changed(value); }
                stepped(direction) => { root.memory-stepped(direction); }
                save-requested => { root.memory-save-requested(); }
                back-requested => { root.memory-back-requested(); }
                retry-requested => { root.memory-retry-requested(); }
                suggestion-requested => { root.memory-suggestion-requested(); }
            }
            if root.diagnostics-visible && !root.auth-visible: DiagnosticsPanel {
                x: (parent.width - self.width) / 2;
                y: 24px;
                width: min(1020px, parent.width - 48px);
                height: parent.height - 48px;
                summary: root.diagnostics-summary;
                log-text: root.diagnostics-text;
                log-path: root.launcher-log-path;
                refreshing: root.diagnostics-refreshing;
                reason: root.diagnostics-reason;
                advice: root.diagnostics-advice;
                details-visible <=> root.diagnostics-details-visible;
                memory-action: root.diagnostics-memory-action && !root.loading;
                repair-action: root.diagnostics-repair-action && root.repair-available && !root.loading;
                memory-requested => { root.diagnostics-visible = false; root.settings-requested(); }
                repair-requested => { root.repair-requested(); }
                retry-enabled: root.retry-available && !root.loading;
                retry-requested => { root.retry-requested(); }
                close-requested => { root.diagnostics-close-requested(); }
                refresh-requested => { root.diagnostics-refresh-requested(); }
                open-folder-requested => { root.logs-folder-requested(); }
            }
            if root.auth-visible: AuthPanel {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 940px; height: 608px;
                verified: root.auth-verified;
                busy: root.auth-busy;
                error: root.auth-error;
                provider: root.auth-provider;
                nickname: root.nickname-input;
                message: root.auth-message;
                link: root.auth-link;
                code: root.auth-code;
                telegram-requested => { root.auth-provider = 1; root.auth-requested(); }
                discord-requested => { root.auth-provider = 2; }
                providers-requested => { root.auth-cancelled(); root.auth-provider = 0; }
                back-requested => { root.auth-back-requested(); }
                open-requested => { root.auth-open-requested(); }
                logout-requested => { root.auth-logout-requested(); }
            }
        }
    }
    if root.java-visible: Rectangle {
        x: 0px; y: 74px * root.u; width: parent.width; height: parent.height - self.y;
        background: #000000b8;
        TouchArea { }
        JavaPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 700px; height: 380px;
            message: root.java-message;
            busy: root.java-busy;
            error: root.java-error;
            can-cancel: root.java-can-cancel;
            progress: root.java-progress;
            install-requested => { root.java-install-requested(); }
            dismiss-requested => { root.java-dismiss-requested(); }
        }
    }
    if root.update-visible: Rectangle {
        x: 0px; y: 74px * root.u; width: parent.width; height: parent.height - self.y;
        background: #000000b8;
        TouchArea { }
        UpdatePanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 660px; height: 340px;
            current-version: root.update-current-version;
            new-version: root.update-version;
            message: root.update-message;
            busy: root.update-busy;
            error: root.update-error;
            can-cancel: root.update-can-cancel;
            progress: root.update-progress;
            install-requested => { root.update-install-requested(); }
            dismiss-requested => { root.update-dismiss-requested(); }
        }
    }

}

export { I18n }
