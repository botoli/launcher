import { I18n } from "../i18n.slint";
import { AssetCatalog } from "../theme/assets.slint";
import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";
export component MainPanel inherits Rectangle {
    in property <string> project-title: "Nevermore";
    in property <string> version;
    in property <string> server-address;
    in property <bool> server-online;
    in property <int> ping-ms;
    in property <string> server-status;
    in property <int> server-signal;
    in property <bool> loading;
    in property <bool> play-enabled: true;
    in property <string> play-label: I18n.tr("Играть");
    in property <float> u: 1;
    callback play-clicked();
    private property <length> play-width: clamp(round(root.width * 0.27 / 8px) * 8px, 192px, 272px);
    background: transparent;
    Rectangle {
        x: 24px; y: 23px; width: 60px; height: 60px;
        background: Palette.ink; border-width: 1px; border-color: Palette.outline; border-radius: 10px;
        Image { x: 8px; y: 8px; width: 44px; height: 44px; source: AssetCatalog.version-icon; image-fit: contain; }
    }
    Text {
        x: 102px; y: 27px; width: 170px; height: 26px;
        text: root.project-title; color: Palette.frost; font-size: 20px; font-weight: 700; overflow: elide;
    }
    Text {
        x: 102px; y: 57px; width: 170px; height: 22px;
        text: "Minecraft " + root.version; color: Palette.muted; font-size: 14px; overflow: elide;
    }
    Rectangle { x: 288px; y: 31px; width: 1px; height: 46px; background: Palette.outline; }
    Rectangle {
        x: 310px; y: 34px; width: 9px; height: 9px; border-radius: 5px;
        background: root.server-online ? #89CB83 : Palette.muted;
    }
    Text {
        x: 329px; y: 27px; width: parent.width - root.play-width - self.x - 40px; height: 24px;
        text: I18n.tr(root.server-status); overflow: elide; font-size: 14px; color: Palette.muted;
    }
    Text {
        x: 329px; y: 57px; width: parent.width - root.play-width - self.x - 40px; height: 22px;
        text: root.server-online && root.ping-ms >= 0 ? root.ping-ms + I18n.tr(" мс") : "—";
        font-size: 17px; color: Palette.frost; font-weight: 600;
    }
    PixelButton {
        x: parent.width - self.width - 24px; y: 23px; width: root.play-width; height: 64px;
        primary: true; label-font-size: 24px;
        sparks: true;
        portal-style: true;
        button-enabled: root.play-enabled && !root.loading;
        label: I18n.tr(root.play-label); show-icon: !root.loading; icon: AssetCatalog.play-icon;
        clicked => { root.play-clicked(); }
    }
}
