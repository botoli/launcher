import { AssetCatalog } from "../theme/assets.slint";
import { Palette } from "../theme/palette.slint";
import { InfoCard } from "info-card.slint";
import { PixelButton } from "pixel-button.slint";

export component MainPanel inherits Rectangle {
    in property <string> project-title;
    in property <string> version;
    in property <string> server-address;
    in property <bool> server-online;
    in property <int> ping-ms;
    in property <string> server-status;
    in property <int> server-signal;
    in property <bool> loading;
    in property <bool> play-enabled: true;
    in property <string> play-label: "Играть";

    callback play-clicked();

    background: transparent;

    Image {
        source: AssetCatalog.main-panel;
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: -18px;
        width: parent.width * 0.28;
        height: self.width * 422 / 531;
        source: AssetCatalog.project-emblem;
        image-fit: contain;
    }

    Text {
        x: parent.width * 0.15;
        y: parent.height * 0.26;
        width: 70%;
        height: 15%;
        text: root.project-title;
        color: Palette.frost;
        font-family: "Trebuchet MS";
        font-size: 40px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: parent.width * 0.10;
        y: parent.height * 0.5;
        width: 80%;
        height: 18%;
        spacing: parent.width * 0.06;

        InfoCard {
            horizontal-stretch: 1;
            icon: AssetCatalog.version-icon;
            label: "Версия";
            value: root.version;
            detail: "";
            asset-backed: true;
        }

        InfoCard {
            horizontal-stretch: 1;
            icon: root.server-signal == 3 ? AssetCatalog.server-icon
                : root.server-signal == 2 ? AssetCatalog.server-fair-icon
                : root.server-signal == 1 ? AssetCatalog.server-poor-icon
                : AssetCatalog.server-unavailable-icon;
            label: root.server-status;
            value: root.server-address;
            detail: root.server-online && root.ping-ms >= 0 ? root.ping-ms + " ms" : "—";
            healthy: root.server-online;
            detail-color: root.server-signal == 3 ? Palette.leaf
                : root.server-signal == 2 ? #e8bf50
                : root.server-signal == 1 ? #ef9278 : Palette.muted;
            asset-backed: true;
        }
    }

    PixelButton {
        x: parent.width * 0.23;
        y: parent.height * 0.72;
        border-radius: 10px;
        width: 54%;
        height: 24%;
        primary: true;
        asset-backed: true;
        button-enabled: root.play-enabled;
        label: root.play-label;

        clicked => {
            if (!root.loading && root.play-enabled) {
                root.play-clicked();
            }
        }
    }
}
