    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.outline;
    border-radius: 12px;
    VerticalLayout {
        padding: 28px;
        spacing: 12px;
        Text {
            text: I18n.tr("Новости");
            color: Palette.frost;
            font-size: 32px;
            font-weight: 600;
        }
        Text {
            text: I18n.tr("Что нового в обновлениях лаунчера");
            color: Palette.muted;
            font-size: 16px;
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            viewport-height: history.preferred-height;
            history := VerticalLayout {
                width: parent.width - 16px;
                spacing: 0px;
                for release[index] in root.releases: ReleaseEntry {
                    width: history.width;
                    release: release;
                    latest: index == 0;
                }
            }
        }
    }
}
