import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
import { ScrollView } from "std-widgets.slint";

struct ReleaseNote {
    version: string,
    title: string,
    changes: [string],
}

component ReleaseEntry inherits Rectangle {
    in property <ReleaseNote> release;
    in property <bool> latest;
    background: transparent;
    preferred-height: max(100px, entry.preferred-height + 48px);
    vertical-stretch: 0;

    Text {
        x: 0px; y: 24px; width: 130px; height: 38px;
        text: root.release.version;
        color: root.latest ? Palette.leaf : Palette.muted;
        font-size: 30px;
        font-weight: 600;
    }
    if root.latest: Text {
        x: 0px; y: 70px; width: 130px; height: 20px;
        text: I18n.tr("Последняя версия");
        color: Palette.leaf;
        font-size: 13px;
    }
    entry := VerticalLayout {
        x: 158px; y: 24px;
        width: root.width - 158px;
        height: self.preferred-height;
        spacing: 14px;
        Text {
            text: root.release.title;
            color: Palette.frost;
            font-size: 22px;
            font-weight: 600;
            wrap: word-wrap;
        }
        for change in root.release.changes: Text {
            text: "• " + change;
            color: Palette.muted;
            font-size: 16px;
            wrap: word-wrap;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.outline;
    }
}

