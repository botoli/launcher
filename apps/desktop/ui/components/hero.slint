import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
export component Hero inherits Rectangle {
    in property <float> u: 1;
    background: transparent;
    Text {
        y: 0px; width: parent.width; height: 62px * root.u;
        text: I18n.tr("Возвращайся"); font-size: 50px * root.u; font-weight: 800;
        letter-spacing: -1.5px * root.u; color: Palette.frost;
    }
    Text {
        y: 59px * root.u; width: parent.width; height: 62px * root.u;
        text: I18n.tr("в свою историю."); font-size: 50px * root.u; font-weight: 800;
        letter-spacing: -1.5px * root.u; color: Palette.frost;
    }
    Text {
        y: 139px * root.u; width: parent.width; height: 30px * root.u;
        text: I18n.tr("Твои лошади. Новые приключения.");
        font-size: 21px * root.u; color: Palette.frost;
    }
}
