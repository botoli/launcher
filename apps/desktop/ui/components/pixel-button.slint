import { Palette } from "../theme/palette.slint";

export component PixelButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <image> surface-image;
    in property <bool> show-icon: false;
    in property <bool> show-surface: false;
    in property <float> surface-opacity: 0.16;
    in property <bool> primary: false;
    in property <length> label-font-size: root.primary ? 29px : 18px;
    in property <bool> asset-backed: false;
    in property <bool> button-enabled: true;

    callback clicked();

    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.label;

    opacity: root.button-enabled ? 1 : 0.48;
    border-width: 1px;
    border-color: keyboard.has-focus ? Palette.frost : root.primary ? #ffc17d : Palette.outline;
    border-radius: 8px;
    background: area.pressed ? (root.primary ? #df934e : #3b2c21)
        : area.has-hover ? (root.primary ? #ffc17d : #35281f)
        : (root.primary ? #ffb465 : #201813);
    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        padding-left: 12px; padding-right: 12px; spacing: 12px; alignment: center;
        if root.show-icon: Rectangle {
            width: 24px; height: parent.height; background: transparent;
            Image { x: 0px; y: (parent.height - self.height) / 2; width: 24px; height: 28px; source: root.icon; image-fit: contain; }
        }
        Text {
            text: root.label;
            color: root.primary ? #201309 : Palette.frost;
            font-size: root.label-font-size;
            font-weight: root.primary ? 700 : 500;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    keyboard := FocusScope {
        enabled: root.button-enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    area := TouchArea {
        enabled: root.button-enabled;
        mouse-cursor: root.button-enabled ? pointer : default;
        clicked => {
            if (root.button-enabled) {
                keyboard.focus();
                root.clicked();
            }
        }
    }
}
