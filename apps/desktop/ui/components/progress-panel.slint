import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";
export component ProgressPanel inherits Rectangle {
    in property <string> status-text;
    in property <string> detail-text;
    in property <string> metrics-text;
    in property <float> progress;
    in property <int> progress-percent;
    in property <bool> has-progress;
    in property <bool> loading;
    in property <bool> show-diagnostics;
    in property <bool> show-cancel;
    in property <bool> cancel-enabled;
    in property <bool> cancel-pending;
    in property <bool> show-retry;
    in property <float> u: 1;
    callback diagnostics-clicked();
    callback cancel-clicked();
    callback retry-clicked();
    private property <length> actions-width: (root.show-diagnostics ? 90px * root.u : 0px) + (root.show-cancel || root.show-retry ? 122px * root.u : 0px);
    background: transparent;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #bfa38433; }
    Rectangle { x: 0px; y: 27px * root.u; width: 13px * root.u; height: 13px * root.u; border-radius: 7px; background: root.loading ? Palette.moss : root.show-diagnostics ? #e18c6e : #70d928; }
    Text {
        x: 32px * root.u; y: 20px * root.u; width: 178px * root.u; height: 28px * root.u;
        text: root.status-text; color: Palette.muted; font-size: 16px * root.u; vertical-alignment: center; overflow: elide;
    }
    track := Rectangle {
        x: 216px * root.u; y: 28px * root.u;
        width: max(0px, parent.width - self.x - root.actions-width); height: 14px * root.u;
        background: #b6a18d20; border-width: 1px; border-color: #bfa38444; border-radius: 7px * root.u;
        clip: true;
        Rectangle {
            y: 0px; x: root.has-progress ? 0px : (parent.width - self.width) * (0.5 - 0.5 * cos(root.phase * 1deg));
            width: root.has-progress ? parent.width * clamp(root.progress, 0, 1) : root.loading ? parent.width * 0.2 : 0px;
            height: parent.height; border-radius: 7px * root.u; background: Palette.moss;
        }
    }
    private property <float> phase;
    Timer { interval: 32ms; running: root.loading && !root.has-progress; triggered => { root.phase = mod(root.phase + 4, 360); } }
    if root.show-diagnostics: PixelButton { x: parent.width - self.width; y: 18px * root.u; width: 80px * root.u; height: 30px * root.u; label: "Логи"; label-font-size: 14px * root.u; clicked => { root.diagnostics-clicked(); } }
    if root.show-cancel || root.show-retry: PixelButton {
        x: parent.width - root.actions-width; y: 18px * root.u;
        width: 112px * root.u; height: 30px * root.u;
        label: root.show-retry ? "Повторить" : root.cancel-pending ? "Отменяем…" : "Отменить";
        label-font-size: 14px * root.u;
        button-enabled: root.show-retry || root.cancel-enabled;
        clicked => { if (root.show-retry) { root.retry-clicked(); } else { root.cancel-clicked(); } }
    }
    if root.loading || root.show-diagnostics || root.detail-text != "": Text {
        x: 32px * root.u; y: 51px * root.u; width: parent.width - self.x; height: 22px * root.u;
        text: root.detail-text + (root.metrics-text != "" ? " · " + root.metrics-text : "") + (root.has-progress ? " · " + root.progress-percent + "%" : "");
        font-size: 13px * root.u; color: Palette.muted; overflow: elide;
    }
}
