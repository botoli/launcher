import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";
export component ProgressPanel inherits Rectangle {
    in property <string> status-text;
    in property <string> detail-text;
    in property <string> metrics-text;
    in property <float> progress;
    in property <int> progress-percent;
    in property <bool> has-progress;
    in property <bool> loading;
    in property <bool> show-diagnostics;
    in property <bool> show-cancel;
    in property <bool> cancel-enabled;
    in property <bool> cancel-pending;
    in property <bool> show-retry;
    in property <float> u: 1;
    callback diagnostics-clicked();
    callback cancel-clicked();
    callback retry-clicked();
    private property <length> actions-width: (root.show-diagnostics ? 90px * root.u : 0px) + (root.show-cancel || root.show-retry ? 122px * root.u : 0px);
    background: transparent;
    Text {
        x: 0px; y: 0px; width: parent.width - root.actions-width; height: 30px;
        text: I18n.tr(root.status-text); color: Palette.muted; font-size: 14px;
        vertical-alignment: center; overflow: elide;
    }
    if root.loading: track := Rectangle {
        x: 0px; y: 42px; width: parent.width; height: 6px;
        background: #b6a18d20; border-radius: 3px; clip: true;
        Rectangle {
            x: root.has-progress ? 0px : (parent.width - self.width) * (0.5 - 0.5 * cos(root.phase * 1deg));
            width: root.has-progress ? parent.width * clamp(root.progress, 0, 1) : parent.width * 0.2;
            height: parent.height; border-radius: 3px; background: Palette.moss;
        }
    }
    private property <float> phase;
    Timer { interval: 32ms; running: root.loading && !root.has-progress; triggered => { root.phase = mod(root.phase + 4, 360); } }
    if root.show-diagnostics: PixelButton { x: parent.width - self.width; y: 0px; width: 80px * root.u; height: 30px * root.u; label: I18n.tr("Логи"); label-font-size: 14px * root.u; clicked => { root.diagnostics-clicked(); } }
    if root.show-cancel || root.show-retry: PixelButton {
        x: parent.width - root.actions-width; y: 0px;
        width: 112px * root.u; height: 30px * root.u;
        label: root.show-retry ? I18n.tr("Повторить") : root.cancel-pending ? I18n.tr("Отменяем…") : I18n.tr("Отменить");
        label-font-size: 14px * root.u;
        button-enabled: root.show-retry || root.cancel-enabled;
        clicked => { if (root.show-retry) { root.retry-clicked(); } else { root.cancel-clicked(); } }
    }
    if root.loading || root.show-diagnostics || root.detail-text != "": Text {
        x: 0px; y: root.loading ? 60px : 36px; width: parent.width - self.x; height: 22px * root.u;
        text: I18n.tr(root.detail-text);
        font-size: 13px * root.u; color: Palette.muted; overflow: elide;
    }
    if root.loading: Text {
        x: 0px; y: 84px; width: parent.width; height: 22px;
        text: I18n.tr(root.metrics-text) + (root.has-progress ? " · " + root.progress-percent + "%" : "");
        font-size: 13px; color: Palette.muted; overflow: elide;
    }
}
