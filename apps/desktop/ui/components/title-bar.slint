import { AssetCatalog } from "../theme/assets.slint";
import { Palette } from "../theme/palette.slint";

export component TitleBar inherits Rectangle {
    in-out property <string> nickname;
    in property <string> nickname-error;
    in property <bool> nickname-enabled: true;
    in property <bool> nickname-editable: true;
    in property <bool> auth-verified;
    in property <bool> account-active;

    in property <bool> settings-enabled: true;
    callback settings-clicked();
    callback account-clicked();
    callback minimize-clicked();
    callback close-clicked();
    callback move-requested(float, float);

    background: #061421ee;
    border-width: 1px;
    border-color: #29495a;

    drag-area := TouchArea {
        x: 374px;
        width: parent.width - self.x - 162px;
        height: parent.height;
        mouse-cursor: self.pressed ? grabbing : grab;

        moved => {
            root.move-requested(
                (self.mouse-x - self.pressed-x) / 1px,
                (self.mouse-y - self.pressed-y) / 1px,
            );
        }
    }

    account := Rectangle {
        x: 10px; y: 5px; width: 304px; height: 50px;
        background: root.account-active ? #183044 : account-area.has-hover ? #122a3d : transparent;
        border-width: 1px;
        border-color: account-keyboard.has-focus ? Palette.leaf : root.account-active ? Palette.bronze : transparent;
        accessible-role: button;
        accessible-label: root.auth-verified ? "Открыть аккаунт " + root.nickname : "Войти в аккаунт";
        Image {
            x: 6px; y: 3px; width: 44px; height: 44px;
            source: AssetCatalog.avatar; image-fit: contain;
        }
        Text {
            x: 62px; y: 5px; width: 220px; height: 23px;
            text: root.auth-verified ? root.nickname : "Войти в аккаунт";
            color: Palette.frost; font-size: 16px; font-weight: 600; overflow: elide;
        }
        Text {
            x: 62px; y: 29px; width: 220px; height: 16px;
            text: root.auth-verified ? "Управление профилем" : "Telegram или Discord";
            color: Palette.muted; font-size: 11px;
        }
        account-keyboard := FocusScope {
            enabled: root.nickname-enabled; focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") { root.account-clicked(); return accept; }
                reject
            }
        }
        account-area := TouchArea {
            enabled: root.nickname-enabled; mouse-cursor: root.nickname-enabled ? pointer : default;
            clicked => { account-keyboard.focus(); root.account-clicked(); }
        }
    }

    settings := Rectangle {
        x: parent.width - 158px; y: 10px; width: 40px; height: 40px;
        background: settings-area.pressed ? #244156 : settings-area.has-hover ? #173248 : transparent;
        border-width: 1px;
        border-color: settings-keyboard.has-focus ? Palette.leaf : transparent;
        opacity: root.settings-enabled ? 1 : 0.4;
        accessible-role: button;
        accessible-label: "Настройки";
        forward-focus: settings-keyboard;
        Image {
            x: 8px; y: 8px; width: 24px; height: 24px;
            source: AssetCatalog.settings-icon; image-fit: contain;
        }
        settings-keyboard := FocusScope {
            enabled: root.settings-enabled; focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") { root.settings-clicked(); return accept; }
                reject
            }
        }
        settings-area := TouchArea {
            enabled: root.settings-enabled;
            mouse-cursor: root.settings-enabled ? pointer : default;
            clicked => { settings-keyboard.focus(); root.settings-clicked(); }
        }
    }

    minimize-area := TouchArea {
        x: parent.width - 108px;
        width: 54px;
        height: parent.height;
        mouse-cursor: pointer;

        clicked => {
            root.minimize-clicked();
        }
    }

    Rectangle {
        x: minimize-area.x;
        width: minimize-area.width;
        height: parent.height;
        background: minimize-area.pressed ? #244156 : minimize-area.has-hover ? #173248 : transparent;

        Text {
            text: "─";
            color: Palette.frost;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    close-area := TouchArea {
        x: parent.width - 54px;
        width: 54px;
        height: parent.height;
        mouse-cursor: pointer;

        clicked => {
            root.close-clicked();
        }
    }

    Rectangle {
        x: close-area.x;
        width: close-area.width;
        height: parent.height;
        background: close-area.pressed ? #713528 : close-area.has-hover ? #51291f : transparent;

        Text {
            text: "×";
            color: #efb39b;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
