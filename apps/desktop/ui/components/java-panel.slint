import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";

export component JavaPanel inherits Rectangle {
    in property <string> message;
    in property <bool> busy;
    in property <bool> error;
    in property <bool> can-cancel: true;
    in property <float> progress;
    callback install-requested();
    callback dismiss-requested();
    background: #211913;
    border-width: 2px;
    border-color: Palette.outline;
    VerticalLayout {
        padding: 30px; spacing: 18px;
        Text {
            text: root.error ? I18n.tr("Java не установлена") : I18n.tr("Java 21 для игры");
            color: Palette.frost; font-family: "Trebuchet MS"; font-size: 28px;
        }
        Text {
            text: I18n.tr(root.message);
            color: root.error ? #ef9d84 : Palette.muted;
            font-size: 17px; wrap: word-wrap; vertical-stretch: 1;
        }
        if root.busy && root.can-cancel: Rectangle {
            height: 10px; background: Palette.outline;
            Rectangle {
                height: parent.height;
                width: parent.width * clamp(root.progress, 0, 1);
                background: Palette.leaf;
            }
        }
        HorizontalLayout {
            height: 52px; spacing: 16px;
            if !root.busy: PixelButton {
                horizontal-stretch: 2; primary: true; label-font-size: 18px;
                label: root.error ? I18n.tr("Повторить") : I18n.tr("Скачать и установить");
                clicked => { root.install-requested(); }
            }
            PixelButton {
                horizontal-stretch: 1;
                label: I18n.tr("Отмена");
                button-enabled: root.can-cancel;
                clicked => { root.dismiss-requested(); }
            }
        }
    }
}
