import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";

export component UpdatePanel inherits Rectangle {
    in property <string> current-version;
    in property <string> new-version;
    in property <string> message;
    in property <bool> busy;
    in property <bool> error;
    in property <bool> can-cancel: true;
    in property <float> progress;
    callback install-requested();
    callback dismiss-requested();
    background: Palette.ink;
    border-width: 2px;
    border-color: Palette.bronze;
    VerticalLayout {
        padding: 30px; spacing: 18px;
        Text {
            text: root.error ? I18n.tr("Обновление не установлено") : I18n.tr("Обновление лаунчера");
            color: Palette.frost; font-family: "Trebuchet MS"; font-size: 28px;
            wrap: word-wrap;
        }
        Text {
            text: I18n.tr("Версия ") + root.current-version + " → " + root.new-version;
            color: Palette.leaf; font-size: 18px;
        }
        Text {
            text: I18n.tr(root.message); color: root.error ? #ef9d84 : Palette.muted;
            font-size: 16px; wrap: word-wrap; vertical-stretch: 1;
        }
        if root.busy: Rectangle {
            height: 12px; background: #122a3d; border-width: 1px; border-color: Palette.outline;
            Rectangle {
                x: 2px; y: 2px; height: parent.height - 4px;
                width: max(0px, (parent.width - 4px) * root.progress);
                background: Palette.leaf;
            }
        }
        HorizontalLayout {
            height: 52px; spacing: 16px;
            if !root.busy: PixelButton {
                horizontal-stretch: 2; primary: true; label-font-size: 18px;
                label: root.error ? I18n.tr("Повторить") : I18n.tr("Обновить и перезапустить");
                clicked => { root.install-requested(); }
            }
            PixelButton {
                horizontal-stretch: 1;
                label: root.busy ? I18n.tr("Отмена") : I18n.tr("Позже");
                button-enabled: !root.busy || root.can-cancel;
                clicked => { root.dismiss-requested(); }
            }
        }
    }
}
