import { PixelButton } from "pixel-button.slint";
import { Palette } from "../theme/palette.slint";

component MemorySlider inherits FocusScope {
    in property <int> value;
    in property <int> minimum: 1024;
    in property <int> maximum;
    in property <bool> slider-enabled;
    callback changed(float);
    callback stepped(int);
    enabled: root.slider-enabled;
    opacity: root.slider-enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-label: "Память Minecraft";
    accessible-value: root.value;
    private property <float> fraction: root.maximum <= root.minimum ? 0 : clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    key-pressed(event) => {
        if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
            root.stepped(-1);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
            root.stepped(1);
            return accept;
        }
        if (event.text == Key.Home) { root.changed(root.minimum); return accept; }
        if (event.text == Key.End) { root.changed(root.maximum); return accept; }
        reject
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        width: parent.width;
        background: Palette.ink;
        border-width: 1px;
        border-color: Palette.outline;
        Rectangle {
            x: 1px;
            y: 1px;
            height: parent.height - 2px;
            width: (parent.width - 2px) * root.fraction;
            background: Palette.moss;
        }
    }
    Rectangle {
        x: (parent.width - self.width) * root.fraction;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 30px;
        background: area.pressed || area.has-hover ? Palette.leaf : Palette.moss;
        border-width: 2px;
        border-color: root.has-focus ? Palette.frost : Palette.bronze;
        border-radius: 6px;
    }
    area := TouchArea {
        enabled: root.slider-enabled;
        mouse-cursor: root.slider-enabled ? ew-resize : default;
        clicked => {
            root.changed(root.minimum + clamp((self.mouse-x - 11px) / max(1px, self.width - 22px), 0, 1) * (root.maximum - root.minimum));
        }
        moved => {
            if (self.pressed) {
                root.changed(root.minimum + clamp((self.mouse-x - 11px) / max(1px, self.width - 22px), 0, 1) * (root.maximum - root.minimum));
            }
        }
    }
}

export component SettingsPanel inherits Rectangle {
    in-out property <string> memory-input;
    in property <int> memory-value;
    in property <int> memory-maximum;
    in property <string> memory-gib;
    in property <string> memory-error;
    in property <string> memory-suggestion;
    in property <bool> memory-detected;
    in property <bool> memory-save-enabled;
    in property <string> installation-path;
    in property <bool> repair-enabled;
    callback repair-requested();
    callback input-edited(string);
    callback slider-changed(float);
    callback stepped(int);
    callback save-requested();
    callback back-requested();
    callback retry-requested();
    callback suggestion-requested();

    // Keep the hierarchy on the editable value, then the slider, then Save.
    // Warm surfaces and amber actions reuse the launcher's existing palette.
    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.outline;
    border-radius: 12px;

    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.back-requested(); return accept; }
            reject
        }
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            Text {
                text: "Настройки";
                color: Palette.frost;
                font-size: 32px;
                font-weight: 600;
                height: 40px;
            }
            Rectangle {
                background: Palette.panel-raised;
                border-width: 1px;
                border-color: Palette.outline;
                border-radius: 8px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 64px;
                        spacing: 24px;
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Оперативная память";
                                color: Palette.frost;
                                font-size: 24px;
                                font-weight: 600;
                            }
                            Text {
                                text: "Объём памяти для Minecraft";
                                color: Palette.muted;
                                font-size: 14px;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 176px;
                            background: Palette.ink;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: input.has-focus ? Palette.leaf : root.memory-error != "" ? #ef9d84 : Palette.bronze;
                            TouchArea {
                                enabled: root.memory-detected;
                                mouse-cursor: text;
                                clicked => { input.focus(); }
                            }
                            input := TextInput {
                                x: 16px;
                                y: 12px;
                                width: parent.width - 64px;
                                height: parent.height - 24px;
                                text <=> root.memory-input;
                                color: Palette.frost;
                                selection-background-color: Palette.moss;
                                selection-foreground-color: Palette.ink;
                                font-size: 28px;
                                font-weight: 600;
                                single-line: true;
                                enabled: root.memory-detected;
                                accessible-label: "Объём памяти в МБ";
                                edited => { root.input-edited(self.text); }
                                key-pressed(event) => {
                                    if (event.text == Key.UpArrow) { root.stepped(1); return accept; }
                                    if (event.text == Key.DownArrow) { root.stepped(-1); return accept; }
                                    reject
                                }
                                accepted => { if (root.memory-save-enabled) { root.save-requested(); } }
                            }
                            Text {
                                x: parent.width - 44px;
                                width: 32px;
                                height: parent.height;
                                text: "МБ";
                                color: Palette.muted;
                                font-size: 16px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    MemorySlider {
                        height: 44px;
                        value: root.memory-value;
                        maximum: root.memory-maximum;
                        slider-enabled: root.memory-detected;
                        changed(value) => { root.slider-changed(value); }
                        stepped(direction) => { root.stepped(direction); }
                    }
                    HorizontalLayout {
                        height: 20px;
                        Text { text: "1024 МБ"; color: Palette.muted; font-size: 14px; }
                        Text {
                            text: root.memory-gib + " ГБ";
                            color: Palette.frost;
                            font-size: 16px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.memory-detected ? root.memory-maximum + " МБ" : "—";
                            color: Palette.muted;
                            font-size: 14px;
                            horizontal-alignment: right;
                        }
                    }
                    Text {
                        text: root.memory-error != "" ? root.memory-error : "Изменения применятся при следующем запуске игры.\nОбщее потребление памяти игрой может быть выше.";
                        color: root.memory-error != "" ? #ef9d84 : Palette.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                        height: 40px;
                    }
                    if root.memory-suggestion != "": HorizontalLayout {
                        spacing: 16px;
                        height: 48px;
                        Text { text: root.memory-suggestion; color: Palette.muted; font-size: 14px; wrap: word-wrap; vertical-alignment: center; }
                        PixelButton {
                            width: 196px;
                            label: "Исправить значение";
                            label-font-size: 16px;
                            clicked => { root.suggestion-requested(); }
                        }
                    }
                    if !root.memory-detected: PixelButton {
                        width: 224px;
                        height: 44px;
                        label: "Определить память снова";
                        label-font-size: 16px;
                        clicked => { root.retry-requested(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Text { text: "Папка игры"; color: Palette.frost; font-size: 16px; height: 24px; }
                Text {
                    text: root.installation-path;
                    color: Palette.muted;
                    font-size: 14px;
                    overflow: elide;
                    height: 24px;
                    accessible-label: "Папка игры: " + root.installation-path;
                }
                HorizontalLayout {
                    height: 44px;
                    spacing: 16px;
                    PixelButton {
                        width: 300px;
                        label: "Проверить и восстановить игру";
                        label-font-size: 16px;
                        button-enabled: root.repair-enabled;
                        clicked => { root.repair-requested(); }
                    }
                    Text {
                        text: "Моды будут скачаны заново.\nЛичные настройки и миры сохранятся.";
                        color: Palette.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            Rectangle { height: 1px; background: Palette.outline; }
            HorizontalLayout {
                height: 48px;
                spacing: 16px;
                PixelButton {
                    width: 176px;
                    label: "Отмена";
                    label-font-size: 16px;
                    clicked => { root.back-requested(); }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                PixelButton {
                    width: 224px;
                    label: "Сохранить изменения";
                    label-font-size: 16px;
                    primary: true;
                    button-enabled: root.memory-save-enabled;
                    clicked => { root.save-requested(); }
                }
            }
        }
    }
}
