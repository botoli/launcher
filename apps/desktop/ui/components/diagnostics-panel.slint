import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";
import { ScrollView } from "std-widgets.slint";

export component DiagnosticsPanel inherits Rectangle {
    in property <string> summary;
    in property <string> log-text;
    in property <string> log-path;
    in property <bool> refreshing;
    callback close-requested();
    callback refresh-requested();
    callback open-folder-requested();

    background: #17110df8;
    border-width: 3px;
    border-color: #bd6048;
    border-radius: 3px;
    VerticalLayout {
        padding: 26px;
        spacing: 14px;
        Text { text: root.summary; color: Palette.frost; font-size: 27px; font-weight: 600; height: 40px; overflow: elide; }
        Text { text: "Причина сбоя и последние строки логов. Текст можно выделить и скопировать."; color: Palette.muted; font-size: 14px; height: 24px; }
        Rectangle {
            vertical-stretch: 1;
            background: #100c09;
            border-width: 1px;
            border-color: Palette.outline;
            ScrollView {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                viewport-width: self.width;
                viewport-height: max(self.height, output.preferred-height);
                output := TextInput {
                    width: parent.width;
                    height: max(parent.height, self.preferred-height);
                    text: root.log-text;
                    color: Palette.frost;
                    font-family: "Consolas";
                    font-size: 13px;
                    single-line: false;
                    read-only: true;
                    wrap: word-wrap;
                    accessible-label: "Подробности ошибки и логи";
                    key-pressed(event) => {
                        if (event.text == Key.Escape) { root.close-requested(); return accept; }
                        reject
                    }
                }
            }
        }
        Text { text: root.log-path; color: Palette.muted; font-size: 12px; height: 20px; overflow: elide; }
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            PixelButton { width: 200px; label: "Скопировать логи"; clicked => { output.select-all(); output.copy(); } }
            PixelButton { width: 230px; label: "Открыть папку логов"; clicked => { root.open-folder-requested(); } }
            PixelButton { width: 170px; label: root.refreshing ? "Чтение..." : "Обновить"; button-enabled: !root.refreshing; clicked => { root.refresh-requested(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            PixelButton { width: 128px; label: "Закрыть"; clicked => { root.close-requested(); } }
        }
    }
}
