import { I18n } from "../i18n.slint";
import { Palette } from "../theme/palette.slint";
import { PixelButton } from "pixel-button.slint";
import { ScrollView } from "std-widgets.slint";

export component DiagnosticsPanel inherits Rectangle {
    in property <string> reason;
    in property <string> advice;
    in property <bool> memory-action;
    in property <bool> repair-action;
    in-out property <bool> details-visible;
    callback memory-requested();
    callback repair-requested();
    in property <string> summary;
    in property <string> log-text;
    in property <string> log-path;
    in property <bool> refreshing;
    in property <bool> retry-enabled;
    callback retry-requested();
    callback close-requested();
    callback refresh-requested();
    callback open-folder-requested();

    background: Palette.panel;
    border-width: 3px;
    border-color: #bd6048;
    border-radius: 3px;
    VerticalLayout {
        padding: 26px;
        spacing: 14px;
        HorizontalLayout {
            height: 40px;
            spacing: 16px;
            Text { text: I18n.tr(root.summary); color: Palette.frost; font-size: 27px; font-weight: 600; overflow: elide; vertical-alignment: center; }
            if root.retry-enabled: PixelButton { width: 128px; label: I18n.tr("Повторить"); label-font-size: 16px; clicked => { root.retry-requested(); } }
        }
        Text { text: I18n.tr(root.reason); color: Palette.frost; font-size: 18px; wrap: word-wrap; }
        Text { text: I18n.tr(root.advice); color: Palette.muted; font-size: 15px; wrap: word-wrap; }
        HorizontalLayout {
            height: 40px;
            spacing: 12px;
            PixelButton { width: 230px; label: root.details-visible ? I18n.tr("Скрыть подробности") : I18n.tr("Показать подробности"); clicked => { root.details-visible = !root.details-visible; } }
            if root.memory-action: PixelButton { width: 200px; label: I18n.tr("Настройки ОЗУ"); clicked => { root.memory-requested(); } }
            if root.repair-action: PixelButton { width: 220px; label: I18n.tr("Восстановить моды"); clicked => { root.repair-requested(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        Rectangle {
            visible: root.details-visible;
            vertical-stretch: 1;
            background: Palette.ink;
            border-width: 1px;
            border-color: Palette.outline;
            ScrollView {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                viewport-width: self.width;
                viewport-height: max(self.height, output.preferred-height);
                output := TextInput {
                    width: parent.width;
                    height: max(parent.height, self.preferred-height);
                    text: root.log-text;
                    color: Palette.frost;
                    font-family: "Consolas";
                    font-size: 13px;
                    single-line: false;
                    read-only: true;
                    wrap: word-wrap;
                    accessible-label: I18n.tr("Подробности ошибки и логи");
                    key-pressed(event) => {
                        if (event.text == Key.Escape) { root.close-requested(); return accept; }
                        reject
                    }
                }
            }
        }
        Text { text: root.log-path; color: Palette.muted; font-size: 12px; height: 20px; overflow: elide; }
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            PixelButton { width: 200px; label: I18n.tr("Скопировать логи"); clicked => { root.details-visible = true; output.select-all(); output.copy(); } }
            PixelButton { width: 230px; label: I18n.tr("Открыть папку логов"); clicked => { root.open-folder-requested(); } }
            PixelButton { width: 170px; label: root.refreshing ? I18n.tr("Чтение...") : I18n.tr("Обновить"); button-enabled: !root.refreshing; clicked => { root.refresh-requested(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            PixelButton { width: 128px; label: I18n.tr("Закрыть"); clicked => { root.close-requested(); } }
        }
    }
}
